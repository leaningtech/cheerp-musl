/* Numeric syscall ids use the Linux i386 syscall numbers. */
@NR@

/* Genericjs can only make syscalls as typed calls of their entry functions.  On the other
 * targets SYS_* are the syscall numbers, and _CHEERP_DIRECT_SYSCALLS selects the typed
 * direct calls there too, which do not link the generic syscall() dispatcher. */
#if (defined(__CHEERP__) && !defined(__ASMJS__)) || defined(_CHEERP_DIRECT_SYSCALLS)
@SYS_ENTRY@
#else
@SYS_NR@
#endif

#ifdef __cplusplus
extern "C" {
#endif

#if defined(__wasm__) && !defined(__CHEERP__)
#define __SYSCALL_ATTR(namestr) __attribute__((import_module("i"), import_name("__syscall_" namestr)))
#else
#define __SYSCALL_ATTR(namestr)
#endif
#define __SYSCALL_DEF(name, nr, ...) long __SYSCALL_ATTR(#name) __syscall_ ## name(__VA_ARGS__)
#include <bits/syscall_list.h>
#undef __SYSCALL_DEF

/* Linux declares these syscalls variadic.  Their entry functions take every argument, and
 * calls that omit the trailing ones pass 0.  The slots that carry either a pointer or an
 * integer, depending on the operation, take either. */
#define __syscall_open(...) __SYSCALL_OPEN(__VA_ARGS__, 0)
#define __SYSCALL_OPEN(path, flags, mode, ...) (__syscall_open)(path, flags, mode)
#define __syscall_openat(...) __SYSCALL_OPENAT(__VA_ARGS__, 0)
#define __SYSCALL_OPENAT(dirfd, path, flags, mode, ...) (__syscall_openat)(dirfd, path, flags, mode)
#define __syscall_fcntl64(...) __SYSCALL_FCNTL64(__VA_ARGS__, 0)
#define __SYSCALL_FCNTL64(fd, op, arg, ...) (__syscall_fcntl64)(fd, op, (unsigned long)(arg))
#define __syscall_futex(...) __SYSCALL_FUTEX(__VA_ARGS__, 0, 0, 0, 0)
#define __SYSCALL_FUTEX(uaddr, op, val, timeout, uaddr2, val3, ...) \
	(__syscall_futex)(uaddr, op, val, (const struct timespec *)(timeout), (const volatile void *)(uaddr2), val3)
#define __syscall_ipc(...) __SYSCALL_IPC(__VA_ARGS__, 0, 0, 0, 0, 0)
#define __SYSCALL_IPC(call, first, second, third, ptr, fifth, ...) \
	(__syscall_ipc)(call, first, second, third, (void *)(ptr), fifth)

#include <errno.h>
static __inline long __syscall_direct_ret(long __r)
{
	if ((unsigned long)__r > -4096UL) {
		errno = -__r;
		return -1;
	}
	return __r;
}
#if (defined(__CHEERP__) && !defined(__ASMJS__)) || defined(_CHEERP_DIRECT_SYSCALLS)
#define syscall(__n, ...) __syscall_direct_ret(__n(__VA_ARGS__))
#endif

/* The typed call of each syscall's entry function, by syscall number.  Inlined into a call
 * with a constant number, it folds to that syscall's entry call. */
#if !(defined(__CHEERP__) && !defined(__ASMJS__))
#define __SYSCALL_NARGS_SEL(_0,_1,_2,_3,_4,_5,_6,_7,N,...) N
#define __SYSCALL_NARGS_OF(...) __SYSCALL_NARGS_SEL(_, __VA_ARGS__ __VA_OPT__(,) 7, 6, 5, 4, 3, 2, 1, 0)
#define __SYSCALL_CAT_X(a,b) a ## b
#define __SYSCALL_CAT(a,b) __SYSCALL_CAT_X(a,b)
/* The entry name is pasted at once: some syscall names are macros too, as getdents64 is in <dirent.h> */
#define __SYSCALL_CASE(name, nr, ...) __SYSCALL_CAT(__SYSCALL_CASE_, __SYSCALL_NARGS_OF(__VA_ARGS__))(nr, __syscall_ ## name);
#define __SYSCALL_CASE_0(nr, entry) case nr: return ((long (*)(void))entry)()
#define __SYSCALL_CASE_1(nr, entry) case nr: return ((long (*)(long))entry)(__a)
#define __SYSCALL_CASE_2(nr, entry) case nr: return ((long (*)(long, long))entry)(__a, __b)
#define __SYSCALL_CASE_3(nr, entry) case nr: return ((long (*)(long, long, long))entry)(__a, __b, __c)
#define __SYSCALL_CASE_4(nr, entry) case nr: return ((long (*)(long, long, long, long))entry)(__a, __b, __c, __d)
#define __SYSCALL_CASE_5(nr, entry) case nr: return ((long (*)(long, long, long, long, long))entry)(__a, __b, __c, __d, __e)
#define __SYSCALL_CASE_6(nr, entry) case nr: return ((long (*)(long, long, long, long, long, long))entry)(__a, __b, __c, __d, __e, __f)
#define __SYSCALL_CASE_7(nr, entry) case nr: return ((long (*)(long, long, long, long, long, long, long))entry)(__a, __b, __c, __d, __e, __f, __g)
static __inline __attribute__((__always_inline__)) long __syscall_dispatch(long __n, long __a, long __b, long __c, long __d, long __e, long __f, long __g)
{
	switch (__n) {
#define __SYSCALL_DEF __SYSCALL_CASE
#include <bits/syscall_list.h>
#undef __SYSCALL_DEF
	}
	return -ENOSYS;
}

#if !defined(_CHEERP_DIRECT_SYSCALLS) && defined(__OPTIMIZE__)
/* A call with a constant syscall number calls that syscall's entry function directly, so
 * that the generic syscall() and every entry it reaches are not linked for it. */
#define syscall(...) __SYSCALL_CONST(__VA_ARGS__, 0, 0, 0, 0, 0, 0, 0)
#define __SYSCALL_CONST(n, a, b, c, d, e, f, g, ...) \
	(__builtin_constant_p(n) \
		? __syscall_direct_ret(__syscall_dispatch((n), (long)(a), (long)(b), (long)(c), (long)(d), (long)(e), (long)(f), (long)(g))) \
		: (syscall)((n), (a), (b), (c), (d), (e), (f), (g)))
#endif
#endif

#ifdef __cplusplus
}
#endif
